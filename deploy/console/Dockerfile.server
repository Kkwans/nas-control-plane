# syntax=docker/dockerfile:1
# Build the non-privileged HTTP Server separately from the host Root Agent.
FROM golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651 AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

ARG BUILD_VERSION=dev

RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build \
    -buildvcs=false \
    -trimpath \
    -ldflags "-X github.com/Kkwans/nas-control-plane/internal/agentsocket.BuildVersion=${BUILD_VERSION}" \
    -o /out/ncp-server \
    ./cmd/ncp-server

FROM alpine:3.23.5@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40

COPY --from=build --chown=1000:100 /out/ncp-server /usr/local/bin/ncp-server

USER 1000:100

ENTRYPOINT ["/usr/local/bin/ncp-server"]
