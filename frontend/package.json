    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@element-plus/icons-vue": "latest",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "latest",
    "@fontsource-variable/manrope": "latest",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@lucide/vue": "latest",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "echarts": "latest",
    "element-plus": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-echarts": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "latest",
    "@vue/tsconfig": "latest",
    "jsdom": "latest",
    "typescript": "~5.9.3",
    "vite": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
