{
  "name": "ncp-console",
  "version": "2026.8.30-v1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build && node scripts/normalize-dist-permissions.mjs && node scripts/check-bundle-budget.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check eslint.config.mjs .prettierrc.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
