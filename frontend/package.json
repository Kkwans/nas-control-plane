    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.1.5",
